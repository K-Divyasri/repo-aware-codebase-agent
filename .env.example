# Copy this file to `.env` and fill in what you need. `.env` is git-ignored.
# EVERYTHING runs with NONE of these set -- index/search/tests/fix/ask/eval all
# work fully offline first. Real mode is optional.

# --- Real Claude tool-use loop (codeagent fix/ask/eval --real) -------------
ANTHROPIC_API_KEY=
# Which Claude model the real tool-use loop calls.
CODEAGENT_MODEL=claude-sonnet-5
